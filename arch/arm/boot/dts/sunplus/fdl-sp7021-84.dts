 */

/dts-v1/;

#include "sunplus-sp7021-achip.dtsi"

/ {
	model = "FigComp-4";
	compatible = "sunplus,sp7021-demo-v3", "sunplus,sp7021";

	aliases {
		serial0 = &uart0;
	};

	chosen {
		bootargs = "console=ttyS0,115200 loglevel=8 root=/dev/mmcblk0p2 rw clk_ignore_unused";
		stdout-path = "serial0:115200n8";
	};

	memory@0 {
		device_type = "memory";
		reg = <0x00000000 0x20000000>; /* 512MB */
	};

	led {
		compatible = "gpio-leds";
		pinctrl-names = "default";
		pinctrl-0 = <&gpio_leds_pins>;

		nLED-SYS-R {
			label = "sys-red";
			gpios = <&pctl 18 GPIO_ACTIVE_LOW>;
			default-state = "off";
			linux,default-trigger = "cpu";
		};
		nLED-SYS-G {
			label = "sys-green";
			gpios = <&pctl 19 GPIO_ACTIVE_LOW>;
			default-state = "off";
			linux,default-trigger = "heartbeat";
		};
		nLED-PWR-R {
			label = "pwr-red";
			gpios = <&pctl 22 GPIO_ACTIVE_LOW>;
			default-state = "off";
		};

		Suicide3 {
			label = "suicide-3";
			gpios = <&pctl 1 GPIO_ACTIVE_HIGH>;
			default-state = "off";
		};
		keepGoing {
			label = "keep-going";
			gpios = <&pctl 2 GPIO_ACTIVE_HIGH>;
			default-state = "on";
		};
		stopCharge {
			label = "stop-charge";
			gpios = <&pctl 28 GPIO_ACTIVE_HIGH>;
			default-state = "off";
		};
		CANterm {
			label = "terminate-can";
			gpios = <&pctl 29 GPIO_ACTIVE_LOW>;
			default-state = "on";
		};
		Totem-output4 {
			label = "totem-output4";
			gpios = <&pctl 32 GPIO_ACTIVE_HIGH>;
			default-state = "off";
		};
		CANstandby {
			label = "can-standby";
			gpios = <&pctl 40 GPIO_ACTIVE_HIGH>;
			default-state = "off";
		};
		POE-ON {
			label = "enable-poe";
			gpios = <&pctl 41 GPIO_ACTIVE_HIGH>;
			default-state = "on";
		};
		Enb_5V {
			label = "enable-5v";
			gpios = <&pctl 44 GPIO_ACTIVE_HIGH>;
			default-state = "off";
		};
		nModemRst {
			label = "modem-reset";
			gpios = <&pctl 47 GPIO_ACTIVE_LOW>;
			default-state = "on";
		};
		SCSIMCtl {
			label = "sim-present";
			gpios = <&pctl 49 GPIO_ACTIVE_HIGH>;
			default-state = "off";
		};
		nEthRst {
			label = "ether-reset";
			gpios = <&pctl 55 GPIO_ACTIVE_LOW>;
			default-state = "off";
		};
		nSIM-A {
			label = "sim-a";
			gpios = <&pctl 46 GPIO_ACTIVE_HIGH>;
			default-state = "on";
		};
		nSIM-B {
			label = "sim-b";
			gpios = <&pctl 45 GPIO_ACTIVE_HIGH>;
			default-state = "off";
		};
		nSIM-C {
			label = "sim-c";
			gpios = <&pctl 48 GPIO_ACTIVE_HIGH>;
			default-state = "on";
		};
	};
};

&spi_controller0 {
	pinctrl-names = "default";
	pinctrl-0 = <&pins_spim0>;
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;

	spidev@0 {
		compatible = "rohm,dh2228fv";
		spi-max-frequency = <5000000>;
		reg = <0>;
	};
};

&spi_controller1 {
	status = "disabled";
};

&spi_controller2 {
	status = "disabled";
};

&spi_controller3 {
	status = "disabled";
};

&i2cm0 {
	pinctrl-names = "default";
	pinctrl-0 = <&i2cm0_pins>;
	clock-frequency = <100000>;
	status = "okay";
};

&i2cm1 {
	pinctrl-names = "default";
	pinctrl-0 = <&i2cm1_pins>;
	clock-frequency = <100000>;
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;

	board_data: eeprom@50 {
		compatible = "atmel,24c04";
		reg = <0x50>;
	};
};

&i2cm2 {
	pinctrl-names = "default";
	pinctrl-0 = <&i2cm2_pins>;
	clock-frequency = <100000>;
	status = "okay";
};

&i2cm3 {
	status = "disabled";
};

&uart1 {
	pinctrl-names = "default";
	pinctrl-0 = <&pins_uart1>;
	status = "okay";
};

&uart2 {
	pinctrl-names = "default";
	pinctrl-0 = <&pins_uart2>;
	status = "okay";
};

&uart3 {
	status = "disabled";
};

&uart4 {
	status = "disabled";
};

&sp_uphy0 {
	pinctrl-names = "default";
	pinctrl-0 = <&pins_vbus_usb0>;
	status = "okay";
};

&sp_uphy1 {
	pinctrl-names = "default";
	pinctrl-0 = <&pins_vbus_usb1>;
	status = "okay";
};

&sp_ehci0 {
	status = "okay";
};

&sp_ohci0 {
	status = "okay";
};

&sp_ehci1 {
	status = "okay";
};

&sp_ohci1 {
	status = "okay";
};

&l2sw {
	pinctrl-names = "default";
	pinctrl-0 = <&l2sw_figcomp3_pins>;
	status = "okay";

	ethernet-ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
			phy-mode = "rmii";
			nvmem-cells = <&mac_addr0>;
			nvmem-cell-names = "mac-address";
			fixed-link {
				speed = <100>;
				full-duplex;
			};
		};
	};

	mdio {
		#address-cells = <1>;
		#size-cells = <0>;
		/* No PHY entries: port 0 is MAC-to-MAC via RMII */
	};
};

&mmc0 {
	status = "disabled";
};

&mmc1 {
	pinctrl-names = "default";
	pinctrl-0 = <&sdcard_pins &figcomp_mmc1_cd_pins>;
	cd-gpios = <&pctl 71 GPIO_ACTIVE_LOW>;
	bus-width = <4>;
	max-frequency = <52000000>;
	disable-wp;
	cap-sd-highspeed;
	no-sdio;
	no-mmc;
	status = "okay";
};

&rtc {
	charging-mode = <0xE>;
};

&pctl {
	pinctrl-names = "default";
	pinctrl-0 = <&pins_gpio_nobinded &func_zero>;

	pins_gpio_nobinded: pinmux_gpio_nobinded-pins {
		sunplus,pins = <
			SPPCTL_IOPAD(24, SPPCTL_PCTL_G_GPIO, 0, SPPCTL_PCTL_L_OUT)
			SPPCTL_IOPAD(25, SPPCTL_PCTL_G_GPIO, 0, SPPCTL_PCTL_L_OUT)
			SPPCTL_IOPAD(26, SPPCTL_PCTL_G_GPIO, 0, SPPCTL_PCTL_L_OUT)
			SPPCTL_IOPAD(31, SPPCTL_PCTL_G_GPIO, 0, SPPCTL_PCTL_L_OUT)
			SPPCTL_IOPAD(32, SPPCTL_PCTL_G_GPIO, 0, SPPCTL_PCTL_L_OUT)
			SPPCTL_IOPAD(33, SPPCTL_PCTL_G_GPIO, 0, SPPCTL_PCTL_L_OUT)
			SPPCTL_IOPAD(35, SPPCTL_PCTL_G_GPIO, 0, SPPCTL_PCTL_L_OUT)
			SPPCTL_IOPAD(82, SPPCTL_PCTL_G_GPIO, 0, SPPCTL_PCTL_L_OUT)
			SPPCTL_IOPAD(84, SPPCTL_PCTL_G_GPIO, 0, SPPCTL_PCTL_L_OUT)
			SPPCTL_IOPAD(85, SPPCTL_PCTL_G_GPIO, 0, SPPCTL_PCTL_L_OUT)
			SPPCTL_IOPAD(86, SPPCTL_PCTL_G_GPIO, 0, SPPCTL_PCTL_L_OUT)
			SPPCTL_IOPAD(87, SPPCTL_PCTL_G_GPIO, 0, SPPCTL_PCTL_L_OUT)
		>;
	};

	func_zero: pinmux_func_zero-pins {
		sunplus,zerofunc = <
			MUXF_L2SW_LED_FLASH0
			MUXF_L2SW_LED_ON0
			MUXF_L2SW_LED_FLASH1
			MUXF_L2SW_LED_ON1
			MUXF_L2SW_P1_MAC_RMII_TXEN
			MUXF_L2SW_P1_MAC_RMII_TXD0
			MUXF_L2SW_P1_MAC_RMII_TXD1
			MUXF_L2SW_P1_MAC_RMII_CRSDV
			MUXF_L2SW_P1_MAC_RMII_RXD0
			MUXF_L2SW_P1_MAC_RMII_RXD1
			MUXF_L2SW_P1_MAC_RMII_RXER
			MUXF_DAISY_MODE
			MUXF_L2SW_P0_MAC_RMII_RXER
			GROP_SPI_FLASH
			GROP_SPI_FLASH_4BIT
			GROP_SPI_NAND
			GROP_CARD0_EMMC
		>;
	};

	i2cm0_pins: pinmux_i2cm0-pins {
		sunplus,pins = <
			SPPCTL_IOPAD(51, SPPCTL_PCTL_G_PMUX, MUXF_I2CM0_DAT, 0)
			SPPCTL_IOPAD(52, SPPCTL_PCTL_G_PMUX, MUXF_I2CM0_CLK, 0)
		>;
	};

	i2cm1_pins: pinmux_i2cm1-pins {
		sunplus,pins = <
			SPPCTL_IOPAD(39, SPPCTL_PCTL_G_PMUX, MUXF_I2CM1_DAT, 0)
			SPPCTL_IOPAD(38, SPPCTL_PCTL_G_PMUX, MUXF_I2CM1_CLK, 0)
		>;
	};

	i2cm2_pins: pinmux_i2cm2-pins {
		sunplus,pins = <
			SPPCTL_IOPAD(8, SPPCTL_PCTL_G_PMUX, MUXF_I2CM2_DAT, 0)
			SPPCTL_IOPAD(9, SPPCTL_PCTL_G_PMUX, MUXF_I2CM2_CLK, 0)
		>;
	};

	l2sw_figcomp3_pins: pinmux_l2sw_figcomp3-pins {
		sunplus,pins = <
			SPPCTL_IOPAD(63, SPPCTL_PCTL_G_PMUX, MUXF_L2SW_CLK_OUT, 0)
			SPPCTL_IOPAD(50, SPPCTL_PCTL_G_PMUX, MUXF_L2SW_MAC_SMI_MDC, 0)
			SPPCTL_IOPAD(64, SPPCTL_PCTL_G_PMUX, MUXF_L2SW_MAC_SMI_MDIO, 0)
			SPPCTL_IOPAD(62, SPPCTL_PCTL_G_PMUX, MUXF_L2SW_P0_MAC_RMII_TXEN, 0)
			SPPCTL_IOPAD(61, SPPCTL_PCTL_G_PMUX, MUXF_L2SW_P0_MAC_RMII_TXD0, 0)
			SPPCTL_IOPAD(60, SPPCTL_PCTL_G_PMUX, MUXF_L2SW_P0_MAC_RMII_TXD1, 0)
			SPPCTL_IOPAD(59, SPPCTL_PCTL_G_PMUX, MUXF_L2SW_P0_MAC_RMII_CRSDV, 0)
			SPPCTL_IOPAD(58, SPPCTL_PCTL_G_PMUX, MUXF_L2SW_P0_MAC_RMII_RXD0, 0)
			SPPCTL_IOPAD(57, SPPCTL_PCTL_G_PMUX, MUXF_L2SW_P0_MAC_RMII_RXD1, 0)
		>;
	};

	pins_vbus_usb0: pinmux_vbus_usb0-pins {
		sunplus,pins = < SPPCTL_IOPAD(90, SPPCTL_PCTL_G_GPIO, 0, SPPCTL_PCTL_L_OU1) >;
	};

	pins_vbus_usb1: pinmux_vbus_usb1-pins {
		sunplus,pins = < SPPCTL_IOPAD(91, SPPCTL_PCTL_G_GPIO, 0, SPPCTL_PCTL_L_OU1) >;
	};

	figcomp_mmc1_cd_pins: pinmux-mmc1-cd-pins {
		sunplus,pins = < SPPCTL_IOPAD(71, SPPCTL_PCTL_G_GPIO, 0, 0) >;
	};

	gpio_leds_pins: pinmux_gpio_leds-pins {
		sunplus,pins = <
			SPPCTL_IOPAD(1,  SPPCTL_PCTL_G_GPIO, 0, SPPCTL_PCTL_L_OUT)
			SPPCTL_IOPAD(2,  SPPCTL_PCTL_G_GPIO, 0, SPPCTL_PCTL_L_OUT)
			SPPCTL_IOPAD(18, SPPCTL_PCTL_G_GPIO, 0, SPPCTL_PCTL_L_OUT)
			SPPCTL_IOPAD(19, SPPCTL_PCTL_G_GPIO, 0, SPPCTL_PCTL_L_OUT)
			SPPCTL_IOPAD(22, SPPCTL_PCTL_G_GPIO, 0, SPPCTL_PCTL_L_OUT)
			SPPCTL_IOPAD(28, SPPCTL_PCTL_G_GPIO, 0, SPPCTL_PCTL_L_OUT)
			SPPCTL_IOPAD(29, SPPCTL_PCTL_G_GPIO, 0, SPPCTL_PCTL_L_OUT)
			SPPCTL_IOPAD(32, SPPCTL_PCTL_G_GPIO, 0, SPPCTL_PCTL_L_OUT)
			SPPCTL_IOPAD(35, SPPCTL_PCTL_G_GPIO, 0, SPPCTL_PCTL_L_OUT)
			SPPCTL_IOPAD(40, SPPCTL_PCTL_G_GPIO, 0, SPPCTL_PCTL_L_OUT)
			SPPCTL_IOPAD(41, SPPCTL_PCTL_G_GPIO, 0, SPPCTL_PCTL_L_OUT)
			SPPCTL_IOPAD(44, SPPCTL_PCTL_G_GPIO, 0, SPPCTL_PCTL_L_OUT)
			SPPCTL_IOPAD(45, SPPCTL_PCTL_G_GPIO, 0, SPPCTL_PCTL_L_OUT)
			SPPCTL_IOPAD(46, SPPCTL_PCTL_G_GPIO, 0, SPPCTL_PCTL_L_OUT)
			SPPCTL_IOPAD(47, SPPCTL_PCTL_G_GPIO, 0, SPPCTL_PCTL_L_OUT)
			SPPCTL_IOPAD(48, SPPCTL_PCTL_G_GPIO, 0, SPPCTL_PCTL_L_OUT)
			SPPCTL_IOPAD(49, SPPCTL_PCTL_G_GPIO, 0, SPPCTL_PCTL_L_OUT)
			SPPCTL_IOPAD(55, SPPCTL_PCTL_G_GPIO, 0, SPPCTL_PCTL_L_OUT)
		>;
	};

	pins_uart1: pinmux_uart1-pins {
		sunplus,pins = <
			SPPCTL_IOPAD(14, SPPCTL_PCTL_G_PMUX, MUXF_UA1_TX, 0)
			SPPCTL_IOPAD(13, SPPCTL_PCTL_G_PMUX, MUXF_UA1_RX, 0)
			SPPCTL_IOPAD(17, SPPCTL_PCTL_G_PMUX, MUXF_UA1_RTS, 0)
			SPPCTL_IOPAD(12, SPPCTL_PCTL_G_PMUX, MUXF_UA1_CTS, 0)
		>;
	};

	pins_uart2: pinmux_uart2-pins {
		sunplus,pins = <
			SPPCTL_IOPAD(36, SPPCTL_PCTL_G_PMUX, MUXF_UA2_TX, 0)
			SPPCTL_IOPAD(37, SPPCTL_PCTL_G_PMUX, MUXF_UA2_RX, 0)
		>;
	};

	pins_spim0: pinmux_spim0-pins {
		sunplus,pins = <
			SPPCTL_IOPAD(21, SPPCTL_PCTL_G_PMUX, MUXF_SPIM0_CLK, 0)
			SPPCTL_IOPAD(20, SPPCTL_PCTL_G_PMUX, MUXF_SPIM0_DO, 0)
			SPPCTL_IOPAD(27, SPPCTL_PCTL_G_PMUX, MUXF_SPIM0_DI, 0)
		>;
	};
};
